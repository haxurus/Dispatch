generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildSettings {
  guildId       String   @id
  guildName     String
  timezone      String   @default("Europe/Rome")
  locale        String   @default("it")
  ticketCounter Int      @default(0)

  antiSpamEnabled               Boolean @default(true)
  antiSpamGlobalCooldownSeconds Int     @default(30)
  antiSpamWindowMinutes         Int     @default(10)
  antiSpamMaxAttempts           Int     @default(5)
  antiSpamBlockMinutes          Int     @default(15)

  transcriptRetentionDays       Int?    @default(30)
  closedTicketRetentionDays     Int?    @default(90)
  retentionDeleteDiscordChannel Boolean @default(true)

  mainMenuEnabled      Boolean  @default(false)
  mainMenuChannelId    String?
  mainMenuMessageId    String?
  mainMenuTitle        String   @default("Centro assistenza")
  mainMenuDescription  String   @default("Premi il pulsante per scegliere il tipo di richiesta.")
  mainMenuButtonLabel  String   @default("Apri un ticket")
  mainMenuCategoryIds  String[] @default([])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categories TicketCategory[]
  panels     TicketPanel[]
  tickets    Ticket[]
  panelRoles PanelRoleBinding[]
  panelAudit PanelAudit[]
  responseTemplates ResponseTemplate[]
  blacklist GuildBlacklist[]
  feedback TicketFeedback[]
}

model TicketCategory {
  id                String   @id @default(cuid())
  guildId           String
  name              String
  description       String?
  discordCategoryId String?
  staffRoleIds      String[] @default([])
  maxOpenPerUser           Int      @default(1)
  openCooldownSeconds      Int      @default(60)
  antiSpamWindowMinutes    Int      @default(10)
  antiSpamMaxAttempts      Int      @default(3)
  formFields               Json     @default("[]")
  slaFirstResponseMinutes  Int?
  slaResolutionMinutes     Int?
  inactivityCloseHours     Int?
  inactivityWarningMinutes Int?
  escalationMinutes        Int?
  escalationRoleIds        String[] @default([])
  reopenWindowHours        Int?
  feedbackEnabled          Boolean  @default(true)
  enabled                  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  guild   GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  tickets Ticket[]
  openAttempts TicketOpenAttempt[]

  @@index([guildId])
}

model TicketPanel {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  channelId   String
  messageId   String?
  title       String
  description String?
  categoryIds String[] @default([])
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

model Ticket {
  id           String   @id @default(cuid())
  ticketNumber Int
  guildId      String
  categoryId   String
  openerId     String
  channelId    String   @unique
  status       String   @default("OPEN")
  priority     String   @default("NORMAL")
  subject      String?
  claimedById  String?
  closeReason            String?
  formDataEncrypted      String?
  firstStaffResponseAt   DateTime?
  lastActivityAt         DateTime @default(now())
  inactivityWarnedAt     DateTime?
  slaFirstBreachedAt      DateTime?
  slaResolutionBreachedAt DateTime?
  escalatedAt              DateTime?
  feedbackRequestedAt      DateTime?
  createdAt                DateTime @default(now())
  updatedAt              DateTime @updatedAt
  closedAt               DateTime?

  guild      GuildSettings  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  members    TicketMember[]
  audit      TicketAudit[]
  transcript Transcript?
  notes      TicketNote[]
  feedback   TicketFeedback?

  @@unique([guildId, ticketNumber])
  @@index([guildId, status, createdAt(sort: Desc)])
  @@index([openerId, status])
  @@index([claimedById, status])
  @@index([status, id])
}

model TicketMember {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  access    String   @default("PARTICIPANT")
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
}

model TicketAudit {
  id        String   @id @default(cuid())
  ticketId  String
  guildId   String
  actorId   String?
  action    String
  details   Json
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
}

model Transcript {
  id               String   @id @default(cuid())
  ticketId         String   @unique
  contentEncrypted String
  messageCount     Int      @default(0)
  createdAt        DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model PanelSession {
  id               String   @id @default(cuid())
  sessionTokenHash String   @unique
  userId           String
  username         String
  avatarUrl        String?
  guilds           Json
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PanelRoleBinding {
  id            String   @id @default(cuid())
  guildId       String
  discordRoleId String
  accessLevel   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, discordRoleId])
  @@index([guildId])
}

model PanelAudit {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  username  String
  action    String
  details   Json
  ipHash    String?
  createdAt DateTime @default(now())

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, createdAt(sort: Desc)])
}


model TicketNote {
  id               String   @id @default(cuid())
  ticketId         String
  guildId          String
  authorId         String
  contentEncrypted String
  createdAt        DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
}

model ResponseTemplate {
  id               String   @id @default(cuid())
  guildId          String
  name             String
  contentEncrypted String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId, createdAt])
}


model TicketFeedback {
  id               String   @id @default(cuid())
  ticketId         String   @unique
  guildId          String
  userId           String
  rating           Int
  commentEncrypted String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  guild  GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, createdAt(sort: Desc)])
  @@index([guildId, rating])
}

model GuildBlacklist {
  id              String   @id @default(cuid())
  guildId         String
  userId          String
  reasonEncrypted String?
  expiresAt       DateTime?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, expiresAt])
}


model TicketOpenAttempt {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  guild    GuildSettings  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  category TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, createdAt(sort: Desc)])
  @@index([guildId, userId, categoryId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model TicketUserGuard {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  lastOpenedAt DateTime?
  pendingUntil DateTime?
  blockedUntil DateTime?
  strikes      Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, blockedUntil])
}
