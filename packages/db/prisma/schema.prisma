generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildSettings {
  guildId       String   @id
  guildName     String
  timezone      String   @default("Europe/Rome")
  // Bot language in this server ('en' | 'it'); new servers start in English.
  locale        String   @default("en")
  ticketCounter Int      @default(0)

  antiSpamEnabled               Boolean @default(true)
  antiSpamGlobalCooldownSeconds Int     @default(30)
  antiSpamWindowMinutes         Int     @default(10)
  antiSpamMaxAttempts           Int     @default(5)
  antiSpamBlockMinutes          Int     @default(15)

  transcriptRetentionDays       Int?
  closedTicketRetentionDays     Int?
  retentionDeleteDiscordChannel Boolean @default(false)

  mainMenuEnabled      Boolean  @default(false)
  mainMenuChannelId    String?
  mainMenuMessageId    String?
  mainMenuTitle        String   @default("Centro assistenza")
  mainMenuDescription  String   @default("Premi il pulsante per scegliere il tipo di richiesta.")
  mainMenuButtonLabel  String   @default("Apri un ticket")
  mainMenuCategoryIds  String[] @default([])

  // Ticket log channel (text/announcement) and the enabled event keys
  // (TICKET_LOG_EVENTS in @dispatch/shared).
  ticketLogChannelId String?
  ticketLogEvents    String[] @default([])

  // Moderator leaderboard: channel, weekly/monthly schedule (weekday 1=Monday
  // ..7, hour 0..23 in `timezone`), size, minimum ratings for the average and
  // the last posted period keys ('2026-W41', '2026-09') for idempotency.
  leaderboardChannelId   String?
  leaderboardWeekly      Boolean @default(false)
  leaderboardMonthly     Boolean @default(false)
  leaderboardSize        Int     @default(10)
  leaderboardMinRatings  Int     @default(3)
  leaderboardWeekday     Int     @default(1)
  leaderboardHour        Int     @default(9)
  leaderboardLastWeekly  String?
  leaderboardLastMonthly String?

  // Set when the bot leaves the server, cleared when it is added again; the
  // API purges the server's data once it is older than the post-removal
  // retention (see apps/api/src/guild-purge.ts).
  leftAt        DateTime?

  // Plan (packages/shared/src/plans.ts). planTier/planExpiresAt: a plan given
  // from the super console (planNote is visible to the instance owner only).
  planTier       String    @default("FREE")
  planExpiresAt  DateTime?
  planNote       String?
  planUpdatedAt  DateTime?
  // Discord guild subscription mirrored by the API (apps/api/src/discord-billing.ts);
  // subscriptionEndsAt is set once it is cancelled.
  subscriptionTier          String?
  subscriptionEndsAt        DateTime?
  subscriptionEntitlementId String?
  subscriptionSyncedAt      DateTime?
  // Plan whose limits were last applied: the API sweep brings the server within
  // a lower plan when the one in force drops below it.
  planLimitsTier String    @default("FREE")
  // Brand plan: bot nickname and banner set on this server.
  brandNickname  String?
  brandBannerSet Boolean   @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categories TicketCategory[]
  panels     TicketPanel[]
  tickets    Ticket[]
  panelRoles PanelRoleBinding[]
  panelAudit PanelAudit[]
  responseTemplates ResponseTemplate[]
  blacklist GuildBlacklist[]
  feedback TicketFeedback[]
  openAttempts TicketOpenAttempt[]
  userGuards TicketUserGuard[]
  forms FormDefinition[]
  formPanels FormPanel[]
  formSubmissions FormSubmission[]
  formSessions FormSession[]
  formPermissions FormPermissionBinding[]

  @@index([leftAt])
  @@index([planTier, planExpiresAt])
}

model TicketCategory {
  id                String   @id @default(cuid())
  guildId           String
  name              String
  description       String?
  discordCategoryId String?
  // Discord category the channel moves to when the ticket is closed.
  closedParentCategoryId String?
  staffRoleIds      String[] @default([])
  maxOpenPerUser           Int      @default(1)
  openCooldownSeconds      Int      @default(60)
  antiSpamWindowMinutes    Int      @default(10)
  antiSpamMaxAttempts      Int      @default(3)
  formFields               Json     @default("[]")
  slaFirstResponseMinutes  Int?
  slaResolutionMinutes     Int?
  inactivityCloseHours     Int?
  inactivityWarningMinutes Int?
  escalationMinutes        Int?
  escalationRoleIds        String[] @default([])
  reopenWindowHours        Int?
  feedbackEnabled          Boolean  @default(true)
  transcriptAutoGenerate   Boolean  @default(false)
  transcriptSendToOpener   Boolean  @default(false)
  transcriptChannelId      String?
  transcriptRetain         Boolean  @default(true)
  enabled                  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  guild   GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  tickets Ticket[]
  openAttempts TicketOpenAttempt[]

  @@index([guildId])
}

model TicketPanel {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  channelId   String
  messageId   String?
  title       String
  description String?
  // Ordered list of the categories offered by the panel.
  categoryIds String[] @default([])
  // SELECT (one dropdown) | BUTTONS (one button per category, 5 per row).
  style        String  @default("SELECT")
  placeholder  String?
  color        Int?
  imageUrl     String?
  thumbnailUrl String?
  footerText   String?
  // Per-category overrides: [{ id, label, emoji, description, buttonStyle }].
  items        Json    @default("[]")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

model Ticket {
  retentionPendingAt DateTime?
  retentionDeleteChannel Boolean?
  id           String   @id @default(cuid())
  ticketNumber Int
  guildId      String
  categoryId   String
  openerId     String
  channelId    String   @unique
  status       String   @default("OPEN")
  priority     String   @default("NORMAL")
  subject      String?
  claimedById  String?
  closeReason            String?
  formDataEncrypted      String?
  firstStaffResponseAt   DateTime?
  lastActivityAt         DateTime @default(now())
  inactivityWarnedAt     DateTime?
  slaFirstBreachedAt      DateTime?
  slaResolutionBreachedAt DateTime?
  escalatedAt              DateTime?
  feedbackRequestedAt      DateTime?
  // Form that created the ticket (closed category override).
  sourceFormId             String?
  // Discord parent before the move to the closed category, restored on reopen.
  openParentId             String?
  // Channel deleted by staff: the row stays for history until retention.
  channelDeletedAt         DateTime?
  // Staff member who closed the ticket (not the opener, not auto-close).
  closedById               String?
  // Moderator credited with the closed ticket: claimer at close ?? staff closer.
  handledById              String?
  // Private staff thread of the ticket channel (never visible to the opener).
  staffThreadId            String?
  createdAt                DateTime @default(now())
  updatedAt              DateTime @updatedAt
  closedAt               DateTime?

  guild      GuildSettings  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sourceForm FormDefinition? @relation(fields: [sourceFormId], references: [id], onDelete: SetNull)
  members    TicketMember[]
  audit      TicketAudit[]
  transcript Transcript?
  notes      TicketNote[]
  feedback   TicketFeedback?

  @@unique([guildId, ticketNumber])
  @@index([guildId, status, createdAt(sort: Desc)])
  @@index([openerId, status])
  @@index([claimedById, status])
  @@index([status, id])
  @@index([guildId, status, closedAt])
  @@index([sourceFormId])
  @@index([guildId, handledById, closedAt])
}

model TicketMember {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  access    String   @default("PARTICIPANT")
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
}

model TicketAudit {
  id        String   @id @default(cuid())
  ticketId  String
  guildId   String
  actorId   String?
  action    String
  details   Json
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
}

model Transcript {
  id               String   @id @default(cuid())
  ticketId         String   @unique
  contentEncrypted String
  messageCount     Int      @default(0)
  createdAt        DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model PanelSession {
  id               String   @id @default(cuid())
  sessionTokenHash String   @unique
  userId           String
  username         String
  avatarUrl        String?
  guilds           Json
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PanelRoleBinding {
  id            String   @id @default(cuid())
  guildId       String
  discordRoleId String
  accessLevel   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, discordRoleId])
  @@index([guildId])
}

model PanelAudit {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  username  String
  action    String
  details   Json
  ipHash    String?
  createdAt DateTime @default(now())

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, createdAt(sort: Desc)])
}


model TicketNote {
  id               String   @id @default(cuid())
  ticketId         String
  guildId          String
  authorId         String
  contentEncrypted String
  createdAt        DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
}

model ResponseTemplate {
  id               String   @id @default(cuid())
  guildId          String
  name             String
  contentEncrypted String
  // Where the canned reply is offered: every ticket, or only tickets of these
  // categories or opened by these forms (empty lists = nowhere).
  allTickets       Boolean  @default(true)
  categoryIds      String[] @default([])
  formIds          String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId, createdAt])
}


model TicketFeedback {
  id               String   @id @default(cuid())
  ticketId         String   @unique
  guildId          String
  userId           String
  rating           Int
  commentEncrypted String?
  // Moderator rated (snapshot at submission); null = unattributed.
  staffUserId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  guild  GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, createdAt(sort: Desc)])
  @@index([guildId, rating])
  @@index([guildId, staffUserId, createdAt(sort: Desc)])
}

model GuildBlacklist {
  id              String   @id @default(cuid())
  guildId         String
  userId          String
  reasonEncrypted String?
  expiresAt       DateTime?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, expiresAt])
}


model TicketOpenAttempt {
  openedAt DateTime?
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  guild    GuildSettings  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  category TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, createdAt(sort: Desc)])
  @@index([guildId, userId, categoryId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([guildId, userId, categoryId, openedAt(sort: Desc)])
}

model TicketUserGuard {
  reservationToken       String?
  reservationCategoryId  String?
  reservationSourceKey   String?
  reservationFormVersion String?
  reservationPhase       String?
  reservationAnswersEncrypted String?
  reservationQuestionIndex Int?
  lastViolationAt        DateTime?
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  lastOpenedAt DateTime?
  pendingUntil DateTime?
  blockedUntil DateTime?
  strikes      Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, blockedUntil])
}


model FormDefinition {
  id                    String   @id @default(cuid())
  guildId               String
  name                  String
  description           String?
  questions             Json     @default("[]")
  enabled               Boolean  @default(true)
  openAt                DateTime?
  closeAt               DateTime?
  deliveryMode          String   @default("EPHEMERAL")
  resultChannelId       String?
  resultRoleIds          String[] @default([])
  allowedRoleIds         String[] @default([])
  deniedRoleIds          String[] @default([])
  maxSubmissionsPerUser  Int      @default(1)
  cooldownSeconds        Int      @default(300)
  submissionWindowMinutes Int     @default(60)
  maxAttemptsPerWindow   Int      @default(5)
  createTicketOnSubmit   Boolean  @default(false)
  ticketCategoryId       String?
  ticketParentCategoryId String?
  // Overrides TicketCategory.closedParentCategoryId for tickets of this form.
  ticketClosedParentCategoryId String?
  ticketStaffRoleIds     String[] @default([])
  ticketPrefix           String   @default("form")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  guild       GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  panels      FormPanel[]
  submissions FormSubmission[]
  sessions    FormSession[]
  permissions FormPermissionBinding[]
  tickets     Ticket[]

  @@index([guildId, enabled])
  @@index([guildId, createdAt])
}

model FormPanel {
  id          String   @id @default(cuid())
  guildId     String
  name        String?
  // Primary form (= formIds[0]): keeps the FK and its cascade.
  formId      String
  // Ordered list of the forms offered by the panel.
  formIds     String[] @default([])
  channelId   String
  messageId   String?
  title       String
  description String?
  buttonLabel String   @default("Compila")
  // BUTTONS (one button per form) | SELECT (one dropdown).
  style        String  @default("BUTTONS")
  placeholder  String?
  color        Int?
  imageUrl     String?
  thumbnailUrl String?
  footerText   String?
  // Per-form overrides: [{ id, label, emoji, description, buttonStyle }].
  items        Json    @default("[]")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  form  FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([formId])
}

model FormSubmission {
  id               String   @id @default(cuid())
  guildId          String
  formId           String
  userId           String
  username         String
  answersEncrypted String
  source           String
  status           String   @default("SUBMITTED")
  reportChannelId  String?
  reportMessageId  String?
  ticketChannelId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  form  FormDefinition @relation(fields: [formId], references: [id], onDelete: Restrict)

  @@index([guildId, formId, createdAt(sort: Desc)])
  @@index([guildId, userId, createdAt(sort: Desc)])
  @@index([formId, userId, createdAt(sort: Desc)])
}

model FormSession {
  id               String   @id @default(cuid())
  guildId          String
  formId           String
  userId           String
  token            String   @unique
  source           String
  channelId        String?
  currentQuestion  Int      @default(0)
  answersEncrypted String?
  state            String   @default("ACTIVE")
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  form  FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, state])
  @@index([expiresAt])
}

model FormPermissionBinding {
  id            String   @id @default(cuid())
  guildId       String
  formId        String
  discordRoleId String
  canManage     Boolean  @default(false)
  canView       Boolean  @default(false)
  canReview     Boolean  @default(false)
  canSubmit     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  form  FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, discordRoleId])
  @@index([guildId, discordRoleId])
}

// Instance-wide installation blacklist managed from the super console.
// kind: USER (installer) | GUILD. Read by the bot on GuildCreate.
model InstallBlock {
  id              String   @id @default(cuid())
  kind            String
  subjectId       String
  reason          String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([kind, subjectId])
  @@index([kind, createdAt(sort: Desc)])
}

// Audit trail of super-console mutations. details is protectJson-encrypted.
model SuperAdminAudit {
  id          String   @id @default(cuid())
  userId      String
  username    String
  action      String
  subjectType String?
  subjectId   String?
  details     Json
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([subjectType, subjectId, createdAt(sort: Desc)])
}

// Instance status notices (single row, id = 1), set from the super console.
// Read by the bot; written only by the API.
model StatusChannel {
  id              Int      @id @default(1)
  guildId         String
  channelId       String
  updatedByUserId String
  updatedAt       DateTime @updatedAt
}

// Single row (id = 1): instance settings from the super console.
model InstanceConfig {
  id             Int      @id @default(1)
  // Contacts shown on the pricing page.
  contactEmail   String?
  contactDiscord String?
  contactUrl     String?
  // Discord Premium Apps guild subscription SKU of each paid plan:
  // { "TIER1": "<sku id>", "TIER2": "<sku id>", "TIER3": "<sku id>" }
  discordSkus    Json      @default("{}")
  // Discord webhook for alarms that must work when the bot is down (encrypted).
  alertWebhookUrl String?
  // Alert routing, quiet hours and daily digest (see apps/api/src/alert-rules.ts).
  alertSettings  Json      @default("{}")
  lastDigestAt   DateTime?
  updatedAt      DateTime @updatedAt
}

// Instance notices (bot startup and errors, servers added or removed,
// subscriptions, bot down/restored) for the super console and the alert
// router. The bot may only insert.
model InstanceEvent {
  id            String    @id @default(cuid())
  source        String
  level         String
  // Routing: category (where it goes) and severity (how loudly).
  category      String    @default("errors")
  severity      String    @default("info")
  // Text key and parameters (in details): rendered in the language of the
  // server the alert is posted to.
  messageKey    String?
  title         String
  details       Json
  // pending → sent | digest → digested | log | failed
  deliveryState String    @default("pending")
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([deliveryState, createdAt])
}

// A problem that lasts: opened and resolved by key (bot.down, discord.sync),
// reminded until resolved or acknowledged.
model Incident {
  id                String    @id @default(cuid())
  key               String
  category          String
  severity          String
  title             String
  description       String?
  messageKey        String?
  params            Json      @default("{}")
  openedAt          DateTime  @default(now())
  resolvedAt        DateTime?
  acknowledgedAt    DateTime?
  acknowledgedBy    String?
  lastRemindedAt    DateTime?
  reminders         Int       @default(0)

  @@index([key, resolvedAt])
  @@index([openedAt(sort: Desc)])
}
